{
  "name": "codex-model-picker",
  "version": "0.1.0",
  "description": "A careful model and reasoning picker for Codex configuration",
  "author": "aAnhTuan-Nguyen",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "npm run setup:electron && electron-vite dev",
    "dev:ui": "vite --config vite.ui.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "^1.4.2",
    "toml-eslint-parser": "^0.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
